<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Edit a Film</title>
  </head>
  <body>
    <%- include('../partials/_navbar.ejs') %>
    <div class="edit">
      <h2>Edit Film</h2>

      <div class="edit form-container">
        <form action="/films/<%= film._id %>?_method=PUT" method="POST" class="edit-form">
          <div class="form-group">
            <label for="title">Title:</label>
            <input type="text" name="title" id="title" value="<%= film.title %>" required />
          </div>

          <div class="form-group">
            <label for="year-released">Year Released:</label>
            <input type="number" name="yearReleased" id="year-released" value="<%= film.yearReleased %>" required />
          </div>

          <div class="form-group">
            <label for="main-actors">Main Actors:</label>
            <input type="text" name="mainActors" id="main-actors" value="<%= film.mainActors %>" required />
          </div>

          <div class="form-group">
            <label for="description">Description:</label>
            <textarea name="description" id="description" required><%= film.description %></textarea>
          </div>

          <div class="form-group">
            <label for="image-URL">Image URL:</label>
            <input type="url" name="imageURL" id="image-URL" value="<%= film.imageURL %>" required />
          </div>

          <button type="submit" class="submit-button">Update</button>

          <% if (typeof errorMessage !== 'undefined') { %>
            <p class="error-message"><%= errorMessage %></p>
          <% } %>
        </form>
      </div>
    </div>
  </body>
</html>