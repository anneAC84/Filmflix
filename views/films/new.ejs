<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Add a New Film</title>
  </head>
  <body>

    <%- include('../partials/_navbar.ejs') %>

    <div class="new-body">
      <div class="new">
        <h1>Add a New Film!</h1>

        <form action="/films" method="POST" class="new-form">
          <div class="input-group">
            <label for="title">Title:</label>
            <input type="text" name="title" id="title" placeholder="Enter film title" required />
          </div>

          <div class="input-group">
            <label for="year-released">Year Released:</label>
            <input type="number" name="yearReleased" id="year-released" placeholder="Enter release year" required />
          </div>

          <div class="input-group">
            <label for="main-actors">Main Actors:</label>
            <input type="text" name="mainActors" id="main-actors" placeholder="Enter main actors" required />
          </div>

          <div class="input-group">
            <label for="description">Description:</label>
            <textarea name="description" id="description" placeholder="Enter film description" required></textarea>
          </div>

          <div class="input-group">
            <label for="image-URL">Image URL:</label>
            <input type="url" name="imageURL" id="image-URL" placeholder="Enter image URL" required />
          </div>

          <button type="submit" class="submit-btn">Add Film</button>

          <% if (typeof errorMessage !== 'undefined') { %>
            <p class="error-message"><%= errorMessage %></p>
          <% } %>
        </form>
      </div>
    </div>

  </body>
</html>
