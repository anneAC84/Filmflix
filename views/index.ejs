<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Filmflix - Home</title>
  </head>
  <body>
    <%- include('partials/_navbar.ejs') %>

    <!-- Hero Section -->
<div class="home-hero">
  <% if (user) { %>
    <h1>Welcome to Filmflix, <%= user.username %>!</h1>
  <% } else { %>
    <h1>Welcome to Filmflix!</h1>
  <% } %>
  <p>Explore, discover, and share your favorite movies with friends!</p>
  <div class="hero-buttons">
    <% if (!user) { %>
      <a href="/auth/sign-up" class="hero-button">Create an Account</a>
      <a href="/auth/sign-in" class="hero-button">Sign In</a>
    <% } %>
      </div>
    </div>

    <div class="featured-movies">
      <h2>Featured Movies</h2>
      <div class="movies-list carousel">
          <!-- Dynamically populated movie cards for featured movies -->
          <% if (featuredMovies && featuredMovies.length > 0) { %>
              <% featuredMovies.forEach((movie) => { %>
                  <div class="movie-card">
                      <a href="/films/<%= movie._id %>">
                          <img src="<%= movie.imageURL %>" alt="<%= movie.title %>" class="movie-image" />
                          <p class="movie-title"><%= movie.title %></p>
                      </a>
                  </div>
              <% }); %>
          <% } else { %>
              <p>No featured movies available</p>
          <% } %>
      </div>
      <div class="browse-more">
          <a href="/films" class="hero-button">Browse All Movies</a>
      </div>
  </div>

    
    <!-- New Releases Section -->
    <div class="category-section">
      <h2>New Releases</h2>
      <div class="movies-list carousel"> <!-- Added carousel class -->
        <% newReleases.forEach((movie) => { %>
          <div class="movie-card">
            <a href="/films/<%= movie._id %>">
              <img src="<%= movie.imageURL %>" alt="<%= movie.title %>" class="movie-image" />
              <p class="movie-title"><%= movie.title %></p>
            </a>
          </div>
        <% }) %>
      </div>
      <div class="browse-more">
        <a href="/films?category=new-releases" class="hero-button">See More New Releases</a>
      </div>
    </div>
    
<!-- Top Rated Movies Section -->
<div class="category-section">
  <h2>Top Rated Movies</h2>
  <div class="movies-list carousel">
    <% topRatedMovies.forEach((movie) => { %>
      <div class="movie-card">
        <a href="/films/<%= movie._id %>">
          <img src="<%= movie.imageURL %>" alt="<%= movie.title %>" class="movie-image" />
          <p class="movie-title"><%= movie.title %></p>
        </a>
      </div>
    <% }) %>
  </div>
  <div class="browse-more">
    <a href="/films?category=top-rated" class="hero-button">See More Top Rated</a>
  </div>
</div>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-container">
        <div class="footer-section">
          <h3>Filmflix</h3>
          <p>&copy; 2025 Filmflix. All Rights Reserved.</p>
        </div>
      </div>   
    </footer>

    <!-- Link the burger menu JavaScript -->
    <script src="/scripts/menu.js" defer></script>
  </body>
</html>